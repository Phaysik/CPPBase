{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 4,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "gcc-release",
            "inherits": "base",
            "displayName": "GCC / Release (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "gcc-debug",
            "inherits": "gcc-release",
            "displayName": "GCC / Debug (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-release",
            "inherits": "base",
            "displayName": "Clang / Release (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-debug",
            "inherits": "clang-release",
            "displayName": "Clang / Debug (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "inherits": "base",
            "displayName": "MSVC / Release (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-debug",
            "inherits": "msvc-release",
            "displayName": "MSVC / Debug (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-cl-release",
            "inherits": "base",
            "displayName": "clang-cl / Release (Ninja)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang-cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "gcc-tests",
            "inherits": "gcc-debug",
            "displayName": "GCC / Tests (Ninja, Catch2)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "TEST_STANDARD": "catch2"
            }
        },
        {
            "name": "clang-tests",
            "inherits": "clang-debug",
            "displayName": "Clang / Tests (Ninja, Catch2)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "TEST_STANDARD": "catch2"
            }
        },
        {
            "name": "coverage",
            "inherits": "base",
            "displayName": "Coverage (Ninja, GCC/Clang only)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "ENABLE_COVERAGE": "ON"
            }
        },
        {
            "name": "benchmarks",
            "inherits": "base",
            "displayName": "Benchmarks (Ninja, Release)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "tracy",
            "inherits": "base",
            "displayName": "Tracy (Ninja, Release)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TRACY": "ON"
            }
        },
        {
            "name": "analysis-clang",
            "inherits": "base",
            "displayName": "Static analysis (Ninja + Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "BUILD_TESTS": "ON",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_SANITIZERS": "OFF",
                "WARNINGS_AS_ERRORS": "OFF"
            }
        },
        {
            "name": "gcc-valgrind",
            "inherits": "gcc-debug",
            "displayName": "GCC / Valgrind (Ninja, tests off)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "ENABLE_SANITIZERS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "targets": [
                "main_app"
            ],
            "jobs": 8
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "targets": [
                "dev_app"
            ],
            "jobs": 8
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "targets": [
                "main_app"
            ],
            "jobs": 8
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "targets": [
                "dev_app"
            ],
            "jobs": 8
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "targets": [
                "main_app"
            ],
            "jobs": 8
        },
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug",
            "targets": [
                "dev_app"
            ],
            "jobs": 8
        },
        {
            "name": "benchmarks",
            "configurePreset": "benchmarks",
            "targets": [
                "benchmark_app"
            ],
            "jobs": 8
        },
        {
            "name": "tracy",
            "configurePreset": "tracy",
            "targets": [
                "tracy_app"
            ],
            "jobs": 8
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "targets": [
                "coverage"
            ],
            "jobs": 8
        },
        {
            "name": "genhtml",
            "configurePreset": "coverage",
            "targets": [
                "genhtml"
            ],
            "jobs": 8
        },
        {
            "name": "valgrind",
            "configurePreset": "gcc-valgrind",
            "targets": [
                "run_valgrind"
            ],
            "jobs": 8
        },
        {
            "name": "tidy",
            "configurePreset": "analysis-clang",
            "targets": [
                "tidy"
            ],
            "jobs": 8
        },
        {
            "name": "run_tidy",
            "configurePreset": "analysis-clang",
            "targets": [
                "run_tidy"
            ],
            "jobs": 8
        },
        {
            "name": "check",
            "configurePreset": "analysis-clang",
            "targets": [
                "check"
            ],
            "jobs": 8
        },
        {
            "name": "flawfinder",
            "configurePreset": "analysis-clang",
            "targets": [
                "flawfinder"
            ],
            "jobs": 8
        },
        {
            "name": "format",
            "configurePreset": "analysis-clang",
            "targets": [
                "format"
            ],
            "jobs": 8
        },
        {
            "name": "format_check",
            "configurePreset": "analysis-clang",
            "targets": [
                "format_check"
            ],
            "jobs": 8
        },
        {
            "name": "analysis",
            "configurePreset": "analysis-clang",
            "targets": [
                "analysis"
            ],
            "jobs": 8
        },
        {
            "name": "gcc-tests",
            "configurePreset": "gcc-tests",
            "targets": [
                "test_app"
            ],
            "jobs": 8
        },
        {
            "name": "clang-tests",
            "configurePreset": "clang-tests",
            "targets": [
                "test_app"
            ],
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "gcc-tests",
            "configurePreset": "gcc-tests",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-tests",
            "configurePreset": "clang-tests",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
